# Copy this file to .env and adjust the values for your environment.
# Never commit the real .env file.

# Secret key used to sign sessions and CSRF tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database connection string.
# Leave unset to use the default SQLite file: instance/smart_parking.db
# DATABASE_URL=sqlite:///smart_parking.db

# Public base URL used when generating facility QR codes.
# For phone scanning on your LAN, use your computer's IP, e.g. http://192.168.1.5:5000
BASE_URL=http://127.0.0.1:5000

# Enable or disable parking fee calculation at checkout (true/false).
# No online payment gateway is integrated; fees are display-only.
FEE_CALCULATION_ENABLED=true

# Minutes a driver has past the scheduled arrival time before an
# unused advance reservation expires and the slot is released.
RESERVATION_HOLD_MINUTES=30

# How many days ahead an advance booking may be made.
MAX_ADVANCE_DAYS=30
